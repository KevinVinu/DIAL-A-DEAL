# AI Provider Credentials (insert your API keys here)
GROQ_API_KEY=
SARVAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Speech-to-Text (Sarvam AI Saaras V4)
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe

# Conversational LLM (Groq-hosted, swappable)
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./dial_a_deal.db

# RAG / Knowledge Base
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30

# Google OAuth 2.0 (Calendar + Gmail)
# Either provide GOOGLE_CLIENT_SECRETS_FILE or GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRETS_FILE=secrets/google_client_secret.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_FILE=secrets/google_token.json

# Scheduling
DEFAULT_TIMEZONE=Asia/Kolkata
FORTIVEX_CALENDAR_ID=primary
FORTIVEX_TEAM_EMAILS=
MEETING_DEFAULT_DURATION_MIN=30
MEETING_WORK_START_HOUR=10
MEETING_WORK_END_HOUR=18
EMAIL_SENDER_NAME=Fortivex AI Team

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
